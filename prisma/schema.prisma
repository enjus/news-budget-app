generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All enum-like fields use String with validation enforced at the API layer via Zod.
// Valid values documented in src/lib/validations.ts.
// This keeps the schema DB-agnostic and migration-friendly (sqlite → postgresql).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  // AppRole: ADMIN | EDITOR | VIEWER
  appRole      String   @default("EDITOR")
  personId     String?  @unique
  person       Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdStories Story[] @relation("storiesCreated")
  createdVideos  Video[] @relation("videosCreated")
  comments       Comment[]
  markersCreated CalendarMarker[] @relation("markersCreated")
  availabilityCreated Availability[] @relation("availabilityCreated")
  availabilityUpdated Availability[] @relation("availabilityUpdated")
  shiftsCreated ShiftAssignment[] @relation("shiftsCreated")

  @@index([appRole])
}

model Person {
  id          String   @id @default(cuid())
  name        String
  // Work email. Required for staff (their company address, where
  // notifications go); optional for contributors (their own professional
  // address, never notified — notifiableEmail() requires isStaff).
  email       String?  @unique
  // PersonRole: REPORTER | EDITOR | PHOTOGRAPHER | GRAPHIC_DESIGNER | PUBLICATION_DESIGNER | OTHER
  defaultRole String   @default("OTHER")
  // Inactive people are hidden from pickers for new assignments/stories but keep
  // their historical assignments, visuals, and comment mentions intact.
  isActive    Boolean  @default(true)
  // Staff vs. contributor, chosen at creation (POST /api/people `kind`) and
  // changed only by admins. Combined with isActive via ROSTER_WHERE
  // (src/lib/utils.ts) for schedule/export membership. Contributors stay
  // isActive:true, isStaff:false — still assignable via PersonPicker/
  // PersonSelect (those filter on isActive only), never notified.
  isStaff     Boolean  @default(false)
  // Roster profile (/roster) — visible to every signed-in user. Edited via
  // PATCH /api/roster/[id] (canEditRosterProfile: self, admin, or any content
  // creator for a contributor); never through updatePersonSchema. See
  // docs/roster.md.
  // Free-text job title ("Business Editor", "Oregon Ducks Beat Reporter") —
  // the newsroom-facing job name, which neither appRole nor defaultRole captures.
  title           String?
  // Desk/work line, shown beside `email`. Not confidential, so it's a Person
  // column rather than PersonPrivate. E.164, e.g. "+15035550123".
  workPhone       String?
  pronouns        String?
  xHandle         String?  // normalized, no "@"
  blueskyHandle   String?  // e.g. "name.bsky.social" or a custom domain
  linkedinSlug    String?  // the linkedin.com/in/<slug> part
  instagramHandle String?  // normalized, no "@"
  languages       String[] @default([]) // codes from ROSTER_LANGUAGES (src/lib/languages.ts)
  // When the person last saved or confirmed their own profile; null = never.
  // Drives the six-month review nudge. Admin edits don't set it.
  rosterReviewedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Personal contact details live in their own table, NOT as Person columns:
  // Person is included in nearly every payload (assignments, pickers, budget
  // polls), and home addresses shouldn't ride along in all of them.
  private          PersonPrivate?
  user             User?
  assignments      StoryAssignment[]
  visuals          Visual[]          @relation("visualAssigned")
  visualsRequested Visual[]          @relation("visualsRequested")
  videoAssignments VideoAssignment[]
  teamMemberships  TeamMember[]
  commentMentions  CommentMention[]
  workSchedules    WorkSchedule[]
  availability     Availability[]
  shifts           ShiftAssignment[]
}

// Personal contact details for the roster (/roster). 1:1 with Person, kept
// separate so they're only ever loaded by the /api/roster/[id] routes. Visible
// to every signed-in user behind a client-side "not for public distribution"
// reminder — trust-based, not an access boundary. See docs/roster.md.
model PersonPrivate {
  personId      String   @id
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personalPhone String?  // E.164, e.g. "+15035550123"
  personalEmail String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?  // state / province
  postalCode    String?
  country       String?
  // Roster map pin (/roster/map), placed by hand — never geocoded from the
  // address. Both set or both null. Placed only through
  // /api/roster/[id]/location; a profile save can only clear it, when the
  // address changes. See docs/roster.md.
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  // Set when an address change cleared the pin, so the person can be prompted
  // to re-add it (no pin alone could just mean they never joined the map).
  // Cleared when they place a pin or opt out.
  mapResetAt        DateTime?
  updatedAt     DateTime @updatedAt
}

// Per-weekday override on a Mon–Fri default. No rows at all = the standard
// week. FULL_DAY | OFF only — no half-day standing patterns (confirmed by
// review: no one on staff has a permanent half-day pattern).
model WorkSchedule {
  id        String   @id @default(cuid())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  weekday   Int      // 0 = Sunday … 6 = Saturday
  // WorkScheduleSegment: FULL_DAY | OFF
  segment   String   @default("FULL_DAY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, weekday])
  @@index([personId])
}

// Org-wide labeled date ranges: company holidays, the annual PTO blackout,
// and plain informational notes. Only HOLIDAY (observed:true) feeds
// resolveDay() today — BLACKOUT/NOTE are schema-complete for later phases.
model CalendarMarker {
  id        String   @id @default(cuid())
  // CalendarMarkerKind: HOLIDAY | BLACKOUT | NOTE
  kind      String
  label     String
  startDate DateTime // date-only, T00:00:00.000Z
  endDate   DateTime // date-only, inclusive — every query uses lte, not lt
  note      String?
  // HOLIDAY only. false = noted on the calendar, but the newsroom works normally.
  observed  Boolean  @default(true)

  createdByUserId String?
  createdByUser   User?    @relation("markersCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([kind])
}

// Explicit per-date overrides against a person's standing WorkSchedule
// pattern — PTO, one-off working days, half days. See resolveDay() in
// src/lib/schedule.ts for the full precedence order. The half-day invariant
// (a date has either one FULL_DAY row or up to two half rows, never both) is
// enforced at write time by the API, not by the schema.
model Availability {
  id       String   @id @default(cuid())
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  date     DateTime // date-only, T00:00:00.000Z
  // AvailabilitySegment: FULL_DAY | MORNING | AFTERNOON
  segment  String   @default("FULL_DAY")
  // AvailabilityStatus: OUT | WORKING | UNAVAILABLE
  status   String
  note     String?

  createdByUserId String?
  createdByUser   User?    @relation("availabilityCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser   User?    @relation("availabilityUpdated", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, date, segment])
  @@index([date])
  @@index([personId, date])
  @@index([date, status])
}

// Named role slots on shift days (weekends + observed holidays) — the
// inverse of Availability: role slots that need people, not people
// declaring status. No (date, shiftRole) uniqueness — two people can share
// a role; the unique key only prevents double-assigning the same person.
model ShiftAssignment {
  id        String   @id @default(cuid())
  date      DateTime // date-only, T00:00:00.000Z
  // ShiftRole: GA_REPORTER | EDITOR | SOCIAL_VIDEO_PRODUCER | VISUAL_JOURNALIST
  shiftRole String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  note      String?

  createdByUserId String?
  createdByUser   User?   @relation("shiftsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, shiftRole, personId])
  @@index([date])
  @@index([personId, date])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  // TeamRole: LEAD | EDITOR | MEMBER (display order — see TEAM_MEMBER_ROLE_ORDER)
  role     String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([teamId, personId])
}

model Story {
  id               String   @id @default(cuid())
  slug             String
  budgetLine       String
  isEnterprise     Boolean  @default(false)
  // StoryStatus: DRAFT | PUBLISHED_ITERATING | PUBLISHED_FINAL | SHELVED
  status           String   @default("DRAFT")
  onlinePubDate    DateTime?
  onlinePubDateTBD Boolean  @default(true)
  printPubDate     DateTime?
  printPubDateTBD  Boolean  @default(true)
  notes            String?
  wordCount        Int?
  notifyTeam       Boolean  @default(false)
  aiContributed    Boolean  @default(false)
  sortOrder        Int      @default(0)
  shelvedAt        DateTime? // set when status → SHELVED, cleared otherwise
  postUrl          String?
  workingDraftUrl  String? // link to in-progress draft doc; hidden from cards once story is published
  onBudget         Boolean  @default(true)
  pitchedAt        DateTime? // non-null → in the Pitches pool (onBudget must be false)
  expiresAt        DateTime? // pitch shelf-life deadline; null = evergreen
  pitchText        String?   // the tip as filed; write-once, never accepted by updateStorySchema
  createdByUserId  String?
  createdByUser    User?    @relation("storiesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  version          Int      @default(0) // optimistic locking — incremented on every PATCH
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments StoryAssignment[]
  visuals     Visual[]
  videos      Video[]
  tags        StoryTag[]
  comments    Comment[]

  @@index([status])
  @@index([isEnterprise])
  @@index([onlinePubDate])
  @@index([printPubDate])
  @@index([status, onlinePubDate])
  @@index([isEnterprise, status])
  @@index([onBudget, status])
  @@index([createdByUserId, onBudget])
  @@index([pitchedAt])
  @@index([pitchedAt, expiresAt])
}

model StoryAssignment {
  id       String   @id @default(cuid())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId  String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  // AssignmentRole: REPORTER | EDITOR | OTHER
  role     String
  createdAt DateTime @default(now())

  @@unique([storyId, personId, role])
}

// Editorial campaign labels — rotate over time, so kept as data (a String tag)
// rather than a boolean column per indicator. New tags can be added without a
// schema migration; see StoryTagEnum in src/lib/validations.ts for valid values.
model StoryTag {
  id        String   @id @default(cuid())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId   String
  // A Tag.key. Deliberately not a foreign key: existing rows predate the Tag
  // table, and an archived Tag must keep rendering on the stories that carry it.
  tag       String
  createdAt DateTime @default(now())

  @@unique([storyId, tag])
  @@index([tag])
}

// Admin-managed editorial tags (see src/lib/tags.ts). Enterprise and AI
// Contributed are NOT Tag rows — they're Story/Video boolean columns with
// special behavior, so the admin panel can never edit or delete them.
model Tag {
  key        String    @id // UPPER_SNAKE, derived from the label once and never changed; stored in StoryTag.tag
  label      String    @unique
  abbrev     String?   // chip text on cards; falls back to label
  color      String    // TAG_COLORS key
  icon       String?   // TAG_ICONS key
  sortOrder  Int       @default(0)
  archivedAt DateTime? // archived tags stay on existing stories but can't be newly applied
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// A visual is a lifecycle row: PLANNED rows are the original "arranged in-house"
// credits; REQUESTED and later rows are asks tracked to delivery (see
// docs/visual-requests-slice-1.md). The status sets live in src/lib/visual-requests.ts.
// storyId is nullable so delivered work can outlive a deleted story (SetNull
// replaces the old cascade — story delete clears the rest explicitly).
model Visual {
  id            String    @id @default(cuid())
  story         Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  storyId       String?
  // VisualType: PHOTO | GRAPHIC | MAP | VIDEO
  type          String
  // VisualStatus: PLANNED | REQUESTED | ASSIGNED | IN_PROGRESS | DELIVERED | DECLINED | CANCELED
  status        String    @default("PLANNED")
  description   String?
  // The assignee, and the credit once delivered.
  person        Person?   @relation("visualAssigned", fields: [personId], references: [id], onDelete: SetNull)
  personId      String?
  requestedBy   Person?   @relation("visualsRequested", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById String?
  // VisualPriority: NORMAL | URGENT (cosmetic)
  priority      String    @default("NORMAL")
  eventDateTime DateTime?
  location      String?
  deadline      DateTime?
  notes         String?
  // https link to the requester's data (SharePoint/OneDrive/Sheets) — never a file upload.
  // Validated by parseDataUrl() in src/lib/visual-requests.ts.
  dataUrl       String?
  declineReason String?
  // archive + icalSequence are unused until later slices; here so they need no second db push.
  archived      Boolean   @default(false)
  archivedAt    DateTime?
  icalSequence  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([storyId])
  @@index([personId])
  @@index([archived])
}

// Videos can be standalone (storyId = null) or attached to a story.
model Video {
  id               String   @id @default(cuid())
  slug             String
  budgetLine       String
  isEnterprise     Boolean  @default(false)
  // StoryStatus: DRAFT | PUBLISHED_ITERATING | PUBLISHED_FINAL | SHELVED
  status           String   @default("DRAFT")
  storyId          String?
  story            Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
  onlinePubDate    DateTime?
  onlinePubDateTBD Boolean  @default(true)
  notes            String?
  notifyTeam       Boolean  @default(false)
  sortOrder        Int      @default(0)
  shelvedAt        DateTime? // set when status → SHELVED, cleared otherwise
  version          Int      @default(0) // optimistic locking — incremented on every PATCH
  youtubeUrl       String?
  reelsUrl         String?
  tiktokUrl        String?
  otherUrl         String?
  onBudget         Boolean  @default(true)
  createdByUserId  String?
  createdByUser    User?    @relation("videosCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments VideoAssignment[]
  comments    Comment[]

  @@index([status])
  @@index([isEnterprise])
  @@index([onlinePubDate])
  @@index([status, onlinePubDate])
  @@index([isEnterprise, status])
  @@index([onBudget, status])
  @@index([createdByUserId, onBudget])
}

model VideoAssignment {
  id       String   @id @default(cuid())
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId  String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  // AssignmentRole: REPORTER | EDITOR | OTHER
  role     String
  createdAt DateTime @default(now())

  @@unique([videoId, personId, role])
}

// Comments hang off either a Story or a Video — exactly one of storyId/videoId
// is set. Prisma can't express that, so the API layer enforces it.
model Comment {
  id         String    @id @default(cuid())
  body       String
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId    String?
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId    String?
  // SetNull plus a denormalized name, so a deleted user's comments keep their byline.
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  authorName String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  mentions CommentMention[]

  @@index([storyId, createdAt])
  @@index([videoId, createdAt])
}

model CommentMention {
  id        String   @id @default(cuid())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  createdAt DateTime @default(now())

  @@unique([commentId, personId])
  @@index([personId])
}

// Newsroom homepage links (/homepage): admin-curated directory of tools and sites,
// grouped into ordered categories. Not named `Link` so the generated type
// doesn't collide with `next/link` imports.
model LinkCategory {
  id        String         @id @default(cuid())
  name      String
  nameKey   String         @unique // categoryNameKey(name): makes names case-insensitively unique
  sortOrder Int            @default(0)
  links     NewsroomLink[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model NewsroomLink {
  id         String       @id @default(cuid())
  category   LinkCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String
  title      String
  url        String
  note       String?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId, sortOrder])
}

// Newsroom homepage announcements (/homepage), newest first. Shown through
// endDate (a newsroom date stored as UTC midnight, like the schedule's
// dates); null endDate = until deleted.
model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String?
  url       String?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([endDate])
}
