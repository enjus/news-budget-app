generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All enum-like fields use String with validation enforced at the API layer via Zod.
// Valid values documented in src/lib/validations.ts.
// This keeps the schema DB-agnostic and migration-friendly (sqlite → postgresql).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  // AppRole: ADMIN | EDITOR | VIEWER
  appRole      String   @default("EDITOR")
  personId     String?  @unique
  person       Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdStories Story[] @relation("storiesCreated")
  createdVideos  Video[] @relation("videosCreated")
  comments       Comment[]
  markersCreated CalendarMarker[] @relation("markersCreated")
  availabilityCreated Availability[] @relation("availabilityCreated")
  availabilityUpdated Availability[] @relation("availabilityUpdated")
  shiftsCreated ShiftAssignment[] @relation("shiftsCreated")

  @@index([appRole])
}

model Person {
  id          String   @id @default(cuid())
  name        String
  // Optional — freelancers and other no-login contributors may not have one.
  // A missing email just means the person is skipped for @-mentions and
  // notification recipients (see collectEmails() in notifications.ts).
  email       String?  @unique
  // PersonRole: REPORTER | EDITOR | PHOTOGRAPHER | GRAPHIC_DESIGNER | PUBLICATION_DESIGNER | OTHER
  defaultRole String   @default("OTHER")
  // Inactive people are hidden from pickers for new assignments/stories but keep
  // their historical assignments, visuals, and comment mentions intact.
  isActive    Boolean  @default(true)
  // On the newsroom staffing roster — set by hand per person by an admin, no
  // backfill. Combined with isActive via ROSTER_WHERE (src/lib/utils.ts) for
  // roster membership. Freelancers stay isActive:true, isStaff:false — still
  // assignable via PersonPicker/PersonSelect (those filter on isActive only).
  isStaff     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User?
  assignments      StoryAssignment[]
  visuals          Visual[]
  videoAssignments VideoAssignment[]
  teamMemberships  TeamMember[]
  commentMentions  CommentMention[]
  workSchedules    WorkSchedule[]
  availability     Availability[]
  shifts           ShiftAssignment[]
}

// Per-weekday override on a Mon–Fri default. No rows at all = the standard
// week. FULL_DAY | OFF only — no half-day standing patterns (confirmed by
// review: no one on staff has a permanent half-day pattern).
model WorkSchedule {
  id        String   @id @default(cuid())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  weekday   Int      // 0 = Sunday … 6 = Saturday
  // WorkScheduleSegment: FULL_DAY | OFF
  segment   String   @default("FULL_DAY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, weekday])
  @@index([personId])
}

// Org-wide labeled date ranges: company holidays, the annual PTO blackout,
// and plain informational notes. Only HOLIDAY (observed:true) feeds
// resolveDay() today — BLACKOUT/NOTE are schema-complete for later phases.
model CalendarMarker {
  id        String   @id @default(cuid())
  // CalendarMarkerKind: HOLIDAY | BLACKOUT | NOTE
  kind      String
  label     String
  startDate DateTime // date-only, T00:00:00.000Z
  endDate   DateTime // date-only, inclusive — every query uses lte, not lt
  note      String?
  // HOLIDAY only. false = noted on the calendar, but the newsroom works normally.
  observed  Boolean  @default(true)

  createdByUserId String?
  createdByUser   User?    @relation("markersCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([kind])
}

// Explicit per-date overrides against a person's standing WorkSchedule
// pattern — PTO, one-off working days, half days. See resolveDay() in
// src/lib/schedule.ts for the full precedence order. The half-day invariant
// (a date has either one FULL_DAY row or up to two half rows, never both) is
// enforced at write time by the API, not by the schema.
model Availability {
  id       String   @id @default(cuid())
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  date     DateTime // date-only, T00:00:00.000Z
  // AvailabilitySegment: FULL_DAY | MORNING | AFTERNOON
  segment  String   @default("FULL_DAY")
  // AvailabilityStatus: OUT | WORKING | UNAVAILABLE
  status   String
  note     String?

  createdByUserId String?
  createdByUser   User?    @relation("availabilityCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser   User?    @relation("availabilityUpdated", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, date, segment])
  @@index([date])
  @@index([personId, date])
  @@index([date, status])
}

// Named role slots on shift days (weekends + observed holidays) — the
// inverse of Availability: role slots that need people, not people
// declaring status. No (date, shiftRole) uniqueness — two people can share
// a role; the unique key only prevents double-assigning the same person.
model ShiftAssignment {
  id        String   @id @default(cuid())
  date      DateTime // date-only, T00:00:00.000Z
  // ShiftRole: GA_REPORTER | EDITOR | SOCIAL_VIDEO_PRODUCER | VISUAL_JOURNALIST
  shiftRole String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  note      String?

  createdByUserId String?
  createdByUser   User?   @relation("shiftsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, shiftRole, personId])
  @@index([date])
  @@index([personId, date])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  // TeamRole: EDITOR | MEMBER
  role     String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([teamId, personId])
}

model Story {
  id               String   @id @default(cuid())
  slug             String
  budgetLine       String
  isEnterprise     Boolean  @default(false)
  // StoryStatus: DRAFT | PUBLISHED_ITERATING | PUBLISHED_FINAL | SHELVED
  status           String   @default("DRAFT")
  onlinePubDate    DateTime?
  onlinePubDateTBD Boolean  @default(true)
  printPubDate     DateTime?
  printPubDateTBD  Boolean  @default(true)
  notes            String?
  wordCount        Int?
  notifyTeam       Boolean  @default(false)
  aiContributed    Boolean  @default(false)
  sortOrder        Int      @default(0)
  shelvedAt        DateTime? // set when status → SHELVED, cleared otherwise
  postUrl          String?
  workingDraftUrl  String? // link to in-progress draft doc; hidden from cards once story is published
  onBudget         Boolean  @default(true)
  createdByUserId  String?
  createdByUser    User?    @relation("storiesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  version          Int      @default(0) // optimistic locking — incremented on every PATCH
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments StoryAssignment[]
  visuals     Visual[]
  videos      Video[]
  tags        StoryTag[]
  comments    Comment[]

  @@index([status])
  @@index([isEnterprise])
  @@index([onlinePubDate])
  @@index([printPubDate])
  @@index([status, onlinePubDate])
  @@index([isEnterprise, status])
  @@index([onBudget, status])
  @@index([createdByUserId, onBudget])
}

model StoryAssignment {
  id       String   @id @default(cuid())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId  String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  // AssignmentRole: REPORTER | EDITOR | OTHER
  role     String
  createdAt DateTime @default(now())

  @@unique([storyId, personId, role])
}

// Editorial campaign labels — rotate over time, so kept as data (a String tag)
// rather than a boolean column per indicator. New tags can be added without a
// schema migration; see StoryTagEnum in src/lib/validations.ts for valid values.
model StoryTag {
  id        String   @id @default(cuid())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId   String
  // StoryTagType: HERE_IS_OREGON | CONTENT_REMIX | SUMMER_FOCUS | OREGON_INSIGHT | VIDEO_POTENTIAL | PUSHED
  tag       String
  createdAt DateTime @default(now())

  @@unique([storyId, tag])
  @@index([tag])
}

model Visual {
  id          String   @id @default(cuid())
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId     String
  // VisualType: PHOTO | GRAPHIC | MAP | VIDEO
  type        String
  description String?
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  personId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Videos can be standalone (storyId = null) or attached to a story.
model Video {
  id               String   @id @default(cuid())
  slug             String
  budgetLine       String
  isEnterprise     Boolean  @default(false)
  // StoryStatus: DRAFT | PUBLISHED_ITERATING | PUBLISHED_FINAL | SHELVED
  status           String   @default("DRAFT")
  storyId          String?
  story            Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
  onlinePubDate    DateTime?
  onlinePubDateTBD Boolean  @default(true)
  notes            String?
  notifyTeam       Boolean  @default(false)
  sortOrder        Int      @default(0)
  shelvedAt        DateTime? // set when status → SHELVED, cleared otherwise
  version          Int      @default(0) // optimistic locking — incremented on every PATCH
  youtubeUrl       String?
  reelsUrl         String?
  tiktokUrl        String?
  otherUrl         String?
  onBudget         Boolean  @default(true)
  createdByUserId  String?
  createdByUser    User?    @relation("videosCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignments VideoAssignment[]
  comments    Comment[]

  @@index([status])
  @@index([isEnterprise])
  @@index([onlinePubDate])
  @@index([status, onlinePubDate])
  @@index([isEnterprise, status])
  @@index([onBudget, status])
  @@index([createdByUserId, onBudget])
}

model VideoAssignment {
  id       String   @id @default(cuid())
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId  String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String
  // AssignmentRole: REPORTER | EDITOR | OTHER
  role     String
  createdAt DateTime @default(now())

  @@unique([videoId, personId, role])
}

// Comments hang off either a Story or a Video — exactly one of storyId/videoId
// is set. Prisma can't express that, so the API layer enforces it.
model Comment {
  id         String    @id @default(cuid())
  body       String
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyId    String?
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId    String?
  // SetNull plus a denormalized name, so a deleted user's comments keep their byline.
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  authorName String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  mentions CommentMention[]

  @@index([storyId, createdAt])
  @@index([videoId, createdAt])
}

model CommentMention {
  id        String   @id @default(cuid())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  createdAt DateTime @default(now())

  @@unique([commentId, personId])
  @@index([personId])
}
