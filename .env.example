# Copy this file to .env and fill in your values.

# PostgreSQL connection string (e.g. Neon, Supabase, Railway, or local Postgres)
# connection_limit and pool_timeout prevent Prisma from exhausting the DB connection pool under load
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connection_limit=10&pool_timeout=15"

# NextAuth — set NEXTAUTH_URL to your app's base URL
NEXTAUTH_URL="http://localhost:3000"

# Generate a secret with: openssl rand -hex 32
NEXTAUTH_SECRET="your-secret-here"

# Subpath deployment (optional — omit for root deployment)
# Must match basePath in next.config.ts. e.g. /news-budget
BASE_PATH=""

# Email notifications — "Save & Notify Team" (optional — omit SMTP_HOST to disable)
# Uses a local postfix relay (no auth). Configure if the server has one.
SMTP_HOST=""
SMTP_PORT="25"
MAIL_FROM="News Budget <newsbudget-noreply@oregonian.com>"
# Public-facing app URL used to build links in notification emails
APP_PUBLIC_URL=""

# Cron jobs — bearer token checked by /api/cron/* routes
CRON_SECRET=""

# Azure AD SSO (optional — omit AZURE_AD_CLIENT_ID to disable SSO)
# See docs/azure-sso-setup.md for Azure Portal setup instructions.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
# Object ID of the Azure AD security group whose members can sign in.
# If set, only members of this group are allowed; others are rejected.
# If omitted, any user in the tenant can sign in via SSO.
AZURE_AD_ALLOWED_GROUP_ID=""
